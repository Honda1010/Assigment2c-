@model IEnumerable<DepartmentDto>

@{
    ViewData["Title"] = "Departments";
}

<h1>All Departments</h1>

<a class="btn btn-primary my-2" asp-action="Create">Create New Department</a>
@if (Model?.Any()??false)
{
    <table class="table table-striped table-hover">
        <thead class="text-center">
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Description</th>
                <th>DateOfCreation</th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody class="text-center">
            @foreach (var department in Model)
            {
                <tr>
                    <td>@department.Code</td>
                    <td>@department.Name</td>
                    <td>@department.Description</td>
                    <td>@department.DateOfCreation.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a class="btn btn-info" asp-action="Details" asp-route-id="@department.DeptId"> <i class="fas fa-eye"></i> Details</a>
                    </td>
                    <td>
                        <a class="btn btn-warning" asp-action="Edit" asp-route-id="@department.DeptId"> <i class="fas fa-edit"></i> Update</a>
                    </td>
                    <td>
                        <a class="btn btn-danger" asp-action="Delete" asp-route-id="@department.DeptId"> <i class="fas fa-trash"></i> Delete</a>
                    </td>
                </tr>
            }
    </table>
   

}
else
{
    <div class="alert alert-info"> 
        No departments found. Please add a new department.
    </div>
}